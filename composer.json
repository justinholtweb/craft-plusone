{
    "name": "justinholtweb/craft-plusone",
    "description": "Social login for Craft 6, managed in the control panel: CP-managed Socialite providers, every SocialiteProviders package, front-end sign-in and connected accounts, built on Craft's own OAuth.",
    "type": "craft-plugin",
    "version": "6.0.0-beta.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "plusone",
        "laravel"
    ],
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-beta.1",
        "laravel/socialite": "^5.23"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.1",
        "socialiteproviders/manager": "^4.8"
    },
    "autoload": {
        "psr-4": {
            "JustinHoltWeb\\PlusOne\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustinHoltWeb\\PlusOne\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check-cs": "pint --test",
        "fix-cs": "pint"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/justinholtweb/craft-plusone/issues",
        "source": "https://github.com/justinholtweb/craft-plusone"
    },
    "extra": {
        "name": "Plus One",
        "handle": "plusone",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-plusone/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-plusone/main/CHANGELOG.md",
        "class": "JustinHoltWeb\\PlusOne\\Plugin"
    },
    "suggest": {
        "socialiteproviders/manager": "Lets Plus One offer any of the 100+ SocialiteProviders packages you install (composer require socialiteproviders/<name>)."
    }
}
